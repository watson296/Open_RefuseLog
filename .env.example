# ──────────────────────────────────────────────
# 필수: 국립중앙의료원(NEMC) 공공데이터 서비스키
# 발급: https://www.data.go.kr → 응급의료정보조회서비스
# ──────────────────────────────────────────────
NEMC_SERVICE_KEY=

# NEMC API 기본 경로 (기본값 사용 가능, 변경 불필요)
NEMC_BASE_URL=https://apis.data.go.kr/B552657/ErmctInfoInqireService
NEMC_REALTIME_PATH=/getEmrrmRltmUsefulSckbdInfoInqire
NEMC_BASIC_PATH=/getEgytBassInfoInqire
NEMC_LIST_PATH=/getEgytListInfoInqire
NEMC_NUM_ROWS=100

# ──────────────────────────────────────────────
# 선택: Google Maps / Routes API
# 발급: https://console.cloud.google.com → Maps JavaScript API
# 없으면 OSRM 공개 라우팅으로 자동 대체됨
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=

# ──────────────────────────────────────────────
# 서버 설정
# ──────────────────────────────────────────────
PORT=3000

# 목업 데이터 폴백 사용 여부 (NEMC 키 없이 테스트할 때 true)
USE_MOCK_FALLBACK=false

# 지도 초기 중심 좌표 및 기본 지역
DEFAULT_STAGE1=부산광역시
DEFAULT_STAGE2=해운대구
DEFAULT_CENTER_LAT=35.1631
DEFAULT_CENTER_LNG=129.1635
